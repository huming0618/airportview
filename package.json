{
  "name": "airportview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first OSM airport footprint viewer",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare-data": "node scripts/prepare-data.js",
    "build:offline": "VITE_BASE=./ vite build",
    "build:android": "VITE_BASE=./ vite build && npx cap sync android",
    "prepare-bboxes": "node scripts/prepare-bboxes.js",
    "cap:sync": "npx cap sync android"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@capacitor/cli": "^6.2.0"
  }
}
